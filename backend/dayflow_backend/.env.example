# ---- Database (same MySQL DB used by Part 1 auth) ----
DATABASE_URL=mysql+pymysql://dayflow_user:change_me@localhost:3306/dayflow_hrms

# ---- JWT (MUST match Part 1's auth service exactly in real deployment) ----
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ---- File storage ----
STORAGE_BACKEND=local
LOCAL_DOCUMENTS_DIR=storage/documents
LOCAL_PROFILE_IMAGES_DIR=storage/profile-images
MAX_DOCUMENT_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# ---- S3 (used when STORAGE_BACKEND=s3) ----
S3_BUCKET=dayflow-hrms-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email (invitations / notifications) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@dayflow.dev
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# For Gmail App Password SMTP in a real environment:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=yourproject@gmail.com
# SMTP_USER=yourproject@gmail.com
# SMTP_PASSWORD=your_google_app_password

# For Cloudflare Email Routing with an external SMTP relay:
# Use your Cloudflare domain as the FROM address and configure a relay
# such as MailChannels (via Cloudflare Workers), SendGrid, or Mailgun.
#
# Example with SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_USE_TLS=true
#
# Example with Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=465
# SMTP_FROM=noreply@yourdomain.com
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASSWORD=your_mailgun_smtp_password
# SMTP_USE_TLS=true

# ---- App ----
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8443

# ---- Cloudflare Turnstile ----
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================================
# Dayflow HRMS - Auth Service - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# ---------- Application ----------
APP_NAME=Dayflow HRMS Auth Service
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- Database (MySQL ONLY) ----------
DATABASE_URL=mysql+pymysql://dayflow_user:CHANGE_ME@localhost:3306/dayflow

# ---------- JWT ----------
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Cloudflare Turnstile (CAPTCHA) ----------
# Secret key stays server-side only. Frontend gets the site key via
# its own build config (VITE_TURNSTILE_SITE_KEY), never from this backend.
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Set to true only in local/dev/test environments to bypass live CAPTCHA calls
CAPTCHA_BYPASS=false

# ---------- SMTP / Email ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=no-reply@dayflow.dev
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true
EMAIL_FROM_NAME=Dayflow HRMS

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Security / Policy ----------
FAILED_LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
